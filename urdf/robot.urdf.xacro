<?xml version="1.0"?>
<robot name="tracked_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <material name="Orange"><color rgba="1.0 0.45 0.0 1.0"/></material>
  <material name="Black"><color rgba="0.08 0.08 0.08 1.0"/></material>
  <material name="Blue"><color rgba="0.1 0.35 0.9 1.0"/></material>

  <link name="base_footprint"/>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.0475"/>
      <geometry><box size="0.30 0.12 0.055"/></geometry>
      <material name="Orange"/>
    </visual>
    <visual>
      <origin xyz="0 0.08 0.03"/>
      <geometry><box size="0.30 0.04 0.06"/></geometry>
      <material name="Black"/>
    </visual>
    <visual>
      <origin xyz="0 -0.08 0.03"/>
      <geometry><box size="0.30 0.04 0.06"/></geometry>
      <material name="Black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.0475"/>
      <geometry><box size="0.30 0.12 0.055"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.045"/>
      <mass value="15.0"/>
      <inertia ixx="0.0218" ixy="0" ixz="0" iyy="0.116" iyz="0" izz="0.1305"/>
    </inertial>
  </link>

  <xacro:macro name="track_wheel" params="name x y">
    <link name="${name}_link">
      <visual>
        <origin rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="0.031" length="0.042"/></geometry>
        <material name="Black"/>
      </visual>
      <collision>
        <origin rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="0.03" length="0.04"/></geometry>
      </collision>
      <inertial>
        <mass value="0.3"/>
        <inertia ixx="0.0001075" ixy="0" ixz="0" iyy="0.000135" iyz="0" izz="0.0001075"/>
      </inertial>
    </link>
    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_link"/>
      <origin xyz="${x} ${y} 0.03"/>
      <axis xyz="0 1 0"/>
    </joint>
    <gazebo reference="${name}_link">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:track_wheel name="wheel_fl" x="0.11" y="0.08"/>
  <xacro:track_wheel name="wheel_rl" x="-0.11" y="0.08"/>
  <xacro:track_wheel name="wheel_fr" x="0.11" y="-0.08"/>
  <xacro:track_wheel name="wheel_rr" x="-0.11" y="-0.08"/>

  <link name="lift_plate_link">
    <visual>
      <geometry><box size="0.28 0.19 0.02"/></geometry>
      <material name="Blue"/>
    </visual>
    <collision>
      <geometry><box size="0.28 0.19 0.02"/></geometry>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.00608" ixy="0" ixz="0" iyy="0.01313" iyz="0" izz="0.01908"/>
    </inertial>
  </link>

  <joint name="lift_joint" type="prismatic">
    <parent link="base_link"/>
    <child link="lift_plate_link"/>
    <origin xyz="0 0 0.085"/>
    <axis xyz="0 0 1"/>
    <limit lower="0.0" upper="0.05" effort="3000" velocity="0.03"/>
    <dynamics damping="50.0" friction="10.0"/>
  </joint>

  <link name="laser_link">
    <visual>
      <geometry><cylinder radius="0.01" length="0.02"/></geometry>
      <material name="Black"/>
    </visual>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <origin xyz="0.145 0 0.05"/>
  </joint>

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>wheel_fl_joint</left_joint>
      <left_joint>wheel_rl_joint</left_joint>
      <right_joint>wheel_fr_joint</right_joint>
      <right_joint>wheel_rr_joint</right_joint>
      <wheel_separation>0.16</wheel_separation>
      <wheel_radius>0.03</wheel_radius>
      <odom_publish_frequency>50</odom_publish_frequency>
      <max_linear_acceleration>0.5</max_linear_acceleration>
      <max_angular_acceleration>1.5</max_angular_acceleration>
      <max_velocity>0.5</max_velocity>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
    </plugin>

    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>lift_joint</joint_name>
      <topic>/lift_cmd</topic>
      <p_gain>5000.0</p_gain>
      <i_gain>100.0</i_gain>
      <d_gain>500.0</d_gain>
      <i_max>1000.0</i_max>
      <i_min>-1000.0</i_min>
      <cmd_max>3000.0</cmd_max>
      <cmd_min>-3000.0</cmd_min>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
    </plugin>
  </gazebo>

</robot>
