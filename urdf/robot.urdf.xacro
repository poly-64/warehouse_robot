<?xml version="1.0"?>
<robot name="tracked_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <material name="Orange"><color rgba="1.0 0.45 0.0 1.0"/></material>
  <material name="Black"><color rgba="0.1 0.1 0.1 1.0"/></material>
  <material name="Steel"><color rgba="0.75 0.75 0.8 1.0"/></material>
  <material name="Rubber"><color rgba="0.2 0.2 0.2 1.0"/></material>

  <link name="base_footprint"/>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ================= ОСНОВНОЙ КОРПУС ================= -->
  <!-- Размеры по ТЗ: Длина 492 мм, Ширина 225 мм, Высота шасси 93 мм (с подушкой 95 мм) -->
  <link name="base_link">
    <!-- Визуальный корпус -->
    <visual>
      <origin xyz="0 0 0.0465"/>
      <geometry><box size="0.492 0.145 0.073"/></geometry>
      <material name="Orange"/>
    </visual>
    <!-- Левая гусеничная балка (высота 74 мм) -->
    <visual>
      <origin xyz="0 0.0925 0.037"/>
      <geometry><box size="0.492 0.04 0.074"/></geometry>
      <material name="Black"/>
    </visual>
    <!-- Правая гусеничная балка (высота 74 мм) -->
    <visual>
      <origin xyz="0 -0.0925 0.037"/>
      <geometry><box size="0.492 0.04 0.074"/></geometry>
      <material name="Black"/>
    </visual>

    <!-- Коллизия корпуса: ширина 216 мм для гарантированного отсутствия заклинивания в проёме 227 мм -->
    <collision>
      <origin xyz="0 0 0.0465"/>
      <geometry><box size="0.488 0.216 0.073"/></geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.045"/>
      <mass value="25.0"/>
      <inertia ixx="0.15" ixy="0" ixz="0" iyy="0.55" iyz="0" izz="0.65"/>
    </inertial>
  </link>

  <!-- Скользящие борта шасси (тефлон, чтобы не залипать на деревянных шашках поддона) -->
  <gazebo reference="base_link">
    <mu1>0.05</mu1>
    <mu2>0.05</mu2>
  </gazebo>

  <!-- ================= ПРИВОДНЫЕ КОЛЕСА (СКРЫТЫ В ГУСЕНИЦАХ) ================= -->
  <xacro:macro name="track_wheel" params="name x y">
    <link name="${name}_link">
      <collision>
        <origin rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="0.037" length="0.038"/></geometry>
      </collision>
      <inertial>
        <mass value="1.0"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
      </inertial>
    </link>

    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_link"/>
      <origin xyz="${x} ${y} 0.037"/>
      <axis xyz="0 1 0"/>
    </joint>

    <gazebo reference="${name}_link">
      <mu1>1.8</mu1>
      <mu2>1.8</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:track_wheel name="wheel_fl" x="0.18" y="0.0925"/>
  <xacro:track_wheel name="wheel_rl" x="-0.18" y="0.0925"/>
  <xacro:track_wheel name="wheel_fr" x="0.18" y="-0.0925"/>
  <xacro:track_wheel name="wheel_rr" x="-0.18" y="-0.0925"/>

  <!-- ================= ПНЕВМОПОДЪЕМНИК ================= -->
  <!-- Высота в сложенном виде: 2 мм (с 93 мм до 95 мм). Ход: 45 мм -->
  <link name="lift_plate_link">
    <visual>
      <origin xyz="0 0 0.001"/>
      <geometry><box size="0.470 0.210 0.002"/></geometry>
      <material name="Rubber"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.001"/>
      <geometry><box size="0.470 0.210 0.002"/></geometry>
    </collision>
    <inertial>
      <mass value="3.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.06"/>
    </inertial>
  </link>

  <joint name="lift_joint" type="prismatic">
    <parent link="base_link"/>
    <child link="lift_plate_link"/>
    <!-- Установлен ровно на отметке 93 мм от пола: 93 + 2 = 95 мм общая высота -->
    <origin xyz="0 0 0.093"/>
    <axis xyz="0 0 1"/>
    <!-- Ход от 0 до 45 мм с усилием пневматики 4000 Н (грузоподъемность > 300 кг) -->
    <limit lower="0.0" upper="0.045" effort="4000" velocity="0.04"/>
    <dynamics damping="80.0" friction="5.0"/>
  </joint>

  <!-- Высокое трение площадки, чтобы поддон не соскальзывал при подъёме -->
  <gazebo reference="lift_plate_link">
    <mu1>2.0</mu1>
    <mu2>2.0</mu2>
  </gazebo>

  <!-- ================= ПЛАГИНЫ ДЛЯ GAZEBO HARMONIC ================= -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>wheel_fl_joint</left_joint>
      <left_joint>wheel_rl_joint</left_joint>
      <right_joint>wheel_fr_joint</right_joint>
      <right_joint>wheel_rr_joint</right_joint>
      <wheel_separation>0.185</wheel_separation>
      <wheel_radius>0.037</wheel_radius>
      <odom_publish_frequency>50</odom_publish_frequency>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <min_linear_acceleration>-1.0</min_linear_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>
      <min_angular_acceleration>-2.0</min_angular_acceleration>
      <max_velocity>0.6</max_velocity>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
    </plugin>

    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>lift_joint</joint_name>
      <topic>/lift_cmd</topic>
      <p_gain>10000.0</p_gain>
      <i_gain>500.0</i_gain>
      <d_gain>800.0</d_gain>
      <cmd_max>4000.0</cmd_max>
      <cmd_min>-1000.0</cmd_min>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
    </plugin>
  </gazebo>

</robot>
