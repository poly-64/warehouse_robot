<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="warehouse">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <gravity>0 0 -9.81</gravity>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.8 0.8 0.85 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Пол -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry></collision>
        <visual name="v"><geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.65 0.65 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ================= СТАНДАРТНЫЙ ЕВРОПОДДОН 1200 x 800 x 144 мм =================
         Смещение Y = -0.18625 m выравнивает правый проём европоддона строго по оси Y = 0.0 -->
    <model name="euro_pallet">
      <pose>2.5 -0.18625 0 0 0 0</pose>
      <static>false</static>
      <link name="pallet_link">
        <inertial>
          <pose>0 0 0.072 0 0 0</pose>
          <mass>25.0</mass>
          <inertia>
            <ixx>1.376</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>3.043</iyy><iyz>0</iyz><izz>4.333</izz>
          </inertia>
        </inertial>

        <!-- 3 нижние опорные доски (толщина 22 мм) -->
        <collision name="bb_l"><pose>0 0.35 0.011 0 0 0</pose><geometry><box><size>1.2 0.1 0.022</size></box></geometry></collision>
        <collision name="bb_c"><pose>0 0.0 0.011 0 0 0</pose><geometry><box><size>1.2 0.145 0.022</size></box></geometry></collision>
        <collision name="bb_r"><pose>0 -0.35 0.011 0 0 0</pose><geometry><box><size>1.2 0.1 0.022</size></box></geometry></collision>
        <visual name="bb_l_v"><pose>0 0.35 0.011 0 0 0</pose><geometry><box><size>1.2 0.1 0.022</size></box></geometry><material><diffuse>0.76 0.6 0.42 1</diffuse></material></visual>
        <visual name="bb_c_v"><pose>0 0.0 0.011 0 0 0</pose><geometry><box><size>1.2 0.145 0.022</size></box></geometry><material><diffuse>0.76 0.6 0.42 1</diffuse></material></visual>
        <visual name="bb_r_v"><pose>0 -0.35 0.011 0 0 0</pose><geometry><box><size>1.2 0.1 0.022</size></box></geometry><material><diffuse>0.76 0.6 0.42 1</diffuse></material></visual>

        <!-- 9 опорных шашек (высота 78 мм: от 22 мм до 100 мм) -->
        <!-- Левый ряд -->
        <collision name="b1"><pose>0.5275 0.35 0.061 0 0 0</pose><geometry><box><size>0.145 0.1 0.078</size></box></geometry></collision>
        <collision name="b2"><pose>0 0.35 0.061 0 0 0</pose><geometry><box><size>0.145 0.1 0.078</size></box></geometry></collision>
        <collision name="b3"><pose>-0.5275 0.35 0.061 0 0 0</pose><geometry><box><size>0.145 0.1 0.078</size></box></geometry></collision>
        <!-- Центральный ряд -->
        <collision name="b4"><pose>0.5275 0 0.061 0 0 0</pose><geometry><box><size>0.145 0.145 0.078</size></box></geometry></collision>
        <collision name="b5"><pose>0 0 0.061 0 0 0</pose><geometry><box><size>0.145 0.145 0.078</size></box></geometry></collision>
        <collision name="b6"><pose>-0.5275 0 0.061 0 0 0</pose><geometry><box><size>0.145 0.145 0.078</size></box></geometry></collision>
        <!-- Правый ряд -->
        <collision name="b7"><pose>0.5275 -0.35 0.061 0 0 0</pose><geometry><box><size>0.145 0.1 0.078</size></box></geometry></collision>
        <collision name="b8"><pose>0 -0.35 0.061 0 0 0</pose><geometry><box><size>0.145 0.1 0.078</size></box></geometry></collision>
        <collision name="b9"><pose>-0.5275 -0.35 0.061 0 0 0</pose><geometry><box><size>0.145 0.1 0.078</size></box></geometry></collision>

        <!-- Визуализация шашек -->
        <visual name="b1v"><pose>0.5275 0.35 0.061 0 0 0</pose><geometry><box><size>0.145 0.1 0.078</size></box></geometry><material><diffuse>0.6 0.45 0.3 1</diffuse></material></visual>
        <visual name="b2v"><pose>0 0.35 0.061 0 0 0</pose><geometry><box><size>0.145 0.1 0.078</size></box></geometry><material><diffuse>0.6 0.45 0.3 1</diffuse></material></visual>
        <visual name="b3v"><pose>-0.5275 0.35 0.061 0 0 0</pose><geometry><box><size>0.145 0.1 0.078</size></box></geometry><material><diffuse>0.6 0.45 0.3 1</diffuse></material></visual>
        <visual name="b4v"><pose>0.5275 0 0.061 0 0 0</pose><geometry><box><size>0.145 0.145 0.078</size></box></geometry><material><diffuse>0.6 0.45 0.3 1</diffuse></material></visual>
        <visual name="b5v"><pose>0 0 0.061 0 0 0</pose><geometry><box><size>0.145 0.145 0.078</size></box></geometry><material><diffuse>0.6 0.45 0.3 1</diffuse></material></visual>
        <visual name="b6v"><pose>-0.5275 0 0.061 0 0 0</pose><geometry><box><size>0.145 0.145 0.078</size></box></geometry><material><diffuse>0.6 0.45 0.3 1</diffuse></material></visual>
        <visual name="b7v"><pose>0.5275 -0.35 0.061 0 0 0</pose><geometry><box><size>0.145 0.1 0.078</size></box></geometry><material><diffuse>0.6 0.45 0.3 1</diffuse></material></visual>
        <visual name="b8v"><pose>0 -0.35 0.061 0 0 0</pose><geometry><box><size>0.145 0.1 0.078</size></box></geometry><material><diffuse>0.6 0.45 0.3 1</diffuse></material></visual>
        <visual name="b9v"><pose>-0.5275 -0.35 0.061 0 0 0</pose><geometry><box><size>0.145 0.1 0.078</size></box></geometry><material><diffuse>0.6 0.45 0.3 1</diffuse></material></visual>

        <!-- 3 поперечные доски (толщина 22 мм: от 100 мм до 122 мм) -->
        <collision name="s1"><pose>0.5275 0 0.111 0 0 0</pose><geometry><box><size>0.145 0.8 0.022</size></box></geometry></collision>
        <collision name="s2"><pose>0 0 0.111 0 0 0</pose><geometry><box><size>0.145 0.8 0.022</size></box></geometry></collision>
        <collision name="s3"><pose>-0.5275 0 0.111 0 0 0</pose><geometry><box><size>0.145 0.8 0.022</size></box></geometry></collision>
        <visual name="s1v"><pose>0.5275 0 0.111 0 0 0</pose><geometry><box><size>0.145 0.8 0.022</size></box></geometry><material><diffuse>0.76 0.6 0.42 1</diffuse></material></visual>
        <visual name="s2v"><pose>0 0 0.111 0 0 0</pose><geometry><box><size>0.145 0.8 0.022</size></box></geometry><material><diffuse>0.76 0.6 0.42 1</diffuse></material></visual>
        <visual name="s3v"><pose>-0.5275 0 0.111 0 0 0</pose><geometry><box><size>0.145 0.8 0.022</size></box></geometry><material><diffuse>0.76 0.6 0.42 1</diffuse></material></visual>

        <!-- Верхний сплошной настил (толщина 22 мм: от 122 мм до 144 мм) -->
        <collision name="top"><pose>0 0 0.133 0 0 0</pose><geometry><box><size>1.2 0.8 0.022</size></box></geometry></collision>
        <visual name="top_v"><pose>0 0 0.133 0 0 0</pose><geometry><box><size>1.2 0.8 0.022</size></box></geometry><material><diffuse>0.85 0.7 0.5 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
